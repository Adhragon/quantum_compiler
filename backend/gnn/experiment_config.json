  "model": {
    "hidden_dim": 64,
    "gcn_layers": 2,
    "mlp_hidden_dim": 128,
    "dropout": 0.15,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 128,
    "epochs": 250,
    "patience": 25
  },
  "split": {
    "train": 0.70,
    "validation": 0.15,
    "test": 0.15
  },
  "routing": {
    "method": "sabre",
    "layout_method_fixed": "trivial",
    "basis_gates": ["cx", "id", "rz", "sx", "x", "swap"],
    "optimization_level": 0,
    "seed_transpiler": 42
  },
  "evaluation": {
    "random_layout_samples": 100,
    "all_candidate_layouts": 2520
  }
}
