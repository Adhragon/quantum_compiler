{
  "project_name": "Quantum Compiler - GNN-Based Qubit Allocation",
  "phase": 2,
  "seed": 42,
  "hardware": {
    "backend": "FakeJakartaV2",
    "expected_physical_qubits": 7
  },
  "benchmarks": [
    {"name": "dj", "label": "dj_5q", "logical_qubits": 5, "source": "MQT Bench"},
    {"name": "ghz", "label": "ghz_5q", "logical_qubits": 5, "source": "MQT Bench"},
    {"name": "graphstate", "label": "graphstate_5q", "logical_qubits": 5, "source": "MQT Bench"}
  ],
  "dataset": {
    "exhaustive": true,
    "output_csv": "data/phase2_data.csv",
